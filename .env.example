# SERVER ONLY. Do not expose DATABASE_URL or JWT secrets to the browser.
# For Supabase use the Session Pooler URI from the Connect panel (may be IPv4 compatible):
# DATABASE_URL=postgresql://postgres.PROJECT_REF:STRONG_PASSWORD@POOLER_HOST:5432/postgres
# DB_SSL=true
DB_SCHEMA=ulo_uat
PGHOST=db
PGPORT=5432
PGUSER=ulo
PGPASSWORD=ulo_local_only
PGDATABASE=ulo_uat
PGPOOL_MAX=5

JWT_ACCESS_SECRET=CHANGE_TO_RANDOM_32_PLUS_CHARACTER_VALUE
JWT_REFRESH_SECRET=CHANGE_TO_DIFFERENT_RANDOM_32_PLUS_CHARACTER_VALUE
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

PORT=3000
NODE_ENV=production
WORKER_UPLOAD_DIR=output
DIFF_DPI=300
SWAGGER_ENABLED=true
