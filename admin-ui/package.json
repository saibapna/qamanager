    "react-hook-form": "^7.52.0",
    "@hookform/resolvers": "^3.9.0",
    "zod": "^3.23.0",
    "axios": "^1.7.0",
    "zustand": "^4.5.0",
    "@monaco-editor/react": "^4.6.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.428.0",
    "date-fns": "^3.6.0",
    "hono": "4.13.19",
    "pg": "8.23.1"
  },
